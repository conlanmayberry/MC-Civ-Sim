{
  "name": "mc-civ-sim",
  "version": "0.1.0",
  "private": true,
  "description": "An artificial-society laboratory: autonomous AI agents in a persistent Minecraft world, with structured telemetry for scientific analysis.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "minecraft:setup": "node scripts/setup-paper.mjs",
    "minecraft:check-latest": "node scripts/setup-paper.mjs --check-latest",
    "minecraft": "node scripts/start-server.mjs",
    "bot": "node src/bot/index.ts",
    "bot:probe": "node tests/probe-version-data.ts",
    "typecheck": "tsc --noEmit",
    "bot:probe-chat": "node tests/probe-commands.ts",
    "diagnose:movement": "node scripts/diagnose-movement.ts",
    "diagnose:movement:live": "node scripts/diagnose-movement.ts --live",
    "bot:probe-path": "node tests/probe-pathfinder.ts",
    "bot:probe-craft": "node tests/probe-crafting.ts",
    "diagnose:pathfinder": "node scripts/diagnose-pathfinder.ts",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "scenario:bootstrap": "node tests/scenario-bootstrap.ts",
    "telemetry": "node src/telemetry/query.ts",
    "agent": "node src/agent/main.ts",
    "talk": "node src/cli/talk.ts",
    "dashboard": "node src/dashboard/server.ts",
    "replay": "node src/replay/main.ts",
    "doctor": "node src/telemetry/query.ts doctor"
  },
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "github:PrismarineJS/mineflayer-pathfinder",
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}

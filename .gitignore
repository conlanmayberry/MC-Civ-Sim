# --- Secrets ---
.env
.env.local
*.key

# --- Node ---
node_modules/
npm-debug.log*
dist/

# --- Minecraft server runtime ---
# The server directory is generated by `npm run minecraft:setup`.
# Only the tracked templates in minecraft/config/ are version-controlled.
minecraft/server/*
!minecraft/server/.gitkeep

# Belt-and-braces: never commit server binaries or the EULA acceptance flag,
# wherever they end up. The EULA must be accepted by a human operator, not by a
# file copied out of git.
*.jar
eula.txt

# --- Generated data (Stage 4+) ---
data/database/
data/logs/
data/experiments/
*.sqlite
*.sqlite-journal
*.sqlite-wal

# --- World backups ---
backups/

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Temporary servers created by npm run diagnose:movement
.diagnose/

# Kill-switch sentinel, created to stop a running agent
STOP

# Copy to `.env` and adjust as needed. `.env` is git-ignored.
#
# Stage 1 only reads MC_PORT and SERVER_MEMORY_* (via scripts/start-server.mjs).
# The remaining values exist so Stage 2's Mineflayer bot has a single place to
# look; they are not consumed by anything yet.

# --- Minecraft server ---
MC_HOST=127.0.0.1
MC_PORT=25565

# Must match minecraft/config/paper-version.json. Leave unset and the bot reads
# the pin file directly, which is the safer default -- see docs/decisions.md
# ADR-001.
MC_VERSION=1.21.8

# --- JVM ---
SERVER_MEMORY_MIN=2G
SERVER_MEMORY_MAX=4G

# --- AI (Stage 5) ---
#
# RUNNING THE AGENT SPENDS REAL MONEY. Every decision is a paid API call.
#
# Get a key from https://platform.openai.com/api-keys and put it here. This file
# is a template -- copy it to .env, which is git-ignored. The key is never
# logged, never written to telemetry, and never included in an error message.
#
# To try the agent loop WITHOUT spending anything:
#     npm run agent -- --dry-run
OPENAI_API_KEY=

# Hard ceiling for a single run, in USD. The agent stops on reaching it, and
# warns at 50/75/90%. Overridable per run with `npm run agent -- --budget 2`.
AI_BUDGET_USD=5

# How often the agent thinks, in seconds. It also thinks early when something
# happens (damage, hunger, death, chat, an operator instruction).
# Lower means more responsive AND more expensive -- cost scales with this.
AI_INTERVAL_SECONDS=30

# The model is pinned in src/ai/pricing.ts (gpt-5.6-luna) rather than set here,
# because the spend cap depends on knowing its price. Changing it means adding
# real prices to that file.

# --- Bot (Stage 2) ---
# The username IS the identity: offline-mode servers derive a stable, name-based
# UUID from it, so reusing a name reuses the agent. Namespace deliberately.
BOT_USERNAME=CivBot_01

# Reconnect backoff. Doubles from initial to max, jittered. Attempts reset on a
# successful spawn. Set BOT_RECONNECT=false to disable reconnecting entirely.
BOT_RECONNECT=true
BOT_RECONNECT_INITIAL_MS=1000
BOT_RECONNECT_MAX_MS=60000
BOT_RECONNECT_MAX_ATTEMPTS=10

# Observation bounds. These cap both telemetry volume (Stage 4) and prompt size
# (Stage 5), so raising them has costs beyond CPU.
BOT_BLOCK_RADIUS=16
BOT_ENTITY_RADIUS=32
BOT_MAX_ENTITIES=25

# Outgoing chat throttle. Minecraft kicks for spam, and a kick triggers the
# reconnect path -- so this being too low presents as a connection problem.
BOT_CHAT_MIN_INTERVAL_MS=900
BOT_COMMAND_PREFIX=bot

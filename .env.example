# Copy to `.env` and adjust as needed. `.env` is git-ignored.
#
# Stage 1 only reads MC_PORT and SERVER_MEMORY_* (via scripts/start-server.mjs).
# The remaining values exist so Stage 2's Mineflayer bot has a single place to
# look; they are not consumed by anything yet.

# --- Minecraft server ---
MC_HOST=127.0.0.1
MC_PORT=25565

# Must match minecraft/config/paper-version.json. Mineflayer will be told to
# speak "26.1" (the protocol-775 major version) even though the server runs
# 26.1.2 -- see docs/decisions.md ADR-001.
MC_VERSION=26.1.2
MC_PROTOCOL_VERSION=26.1

# --- JVM ---
SERVER_MEMORY_MIN=2G
SERVER_MEMORY_MAX=4G

# --- AI (Stage 5 -- deliberately absent) ---
# No ANTHROPIC_API_KEY here yet. The authentication strategy is an open decision
# recorded in docs/decisions.md; adding the variable now would imply a choice we
# have not made and could cause unintended API charges.
